# Copy to .env next to compose.prod.yaml and fill in. Never commit .env.

# Required: signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Database password (the database is only reachable inside the compose network).
POSTGRES_PASSWORD=change-me

# Usernames (letters, digits, underscores; comma-separated) that can open the surveillance view.
ADMIN_USERNAMES=

# Seed a demo slate on first start, and when its IPO opens and how long it runs.
DEMO_SEED=true
DEMO_IPO_OPENS_IN=1m
DEMO_IPO_DURATION=10m

# Host ports.
WEB_PORT=8088
SIMULATOR_PORT=8081
